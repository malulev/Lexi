# ---------------------------------------------------------------------------
# One installation, one website. Every value here names that single site.
# Secrets live here; non-secret operational settings live in the site's own
# repository at .webagent/config.yml (contracts/repo-files.md).
# ---------------------------------------------------------------------------

# --- Version control -------------------------------------------------------
# The GitHub App that may read and write contents and pull requests on the one
# repository this installation manages.
GITHUB_APP_ID=
# PEM private key. Newlines may be written literally as \n.
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
# owner/name. Exactly one repository; there is no second.
GITHUB_REPO=client-org/client-site

# --- Hosting ---------------------------------------------------------------
# Netlify personal access token and the one site it serves. Deploy Previews
# must be enabled on that site or there is no preview to approve.
NETLIFY_TOKEN=
NETLIFY_SITE_ID=
# Shared secret configured on the Netlify outgoing webhook, used to verify
# that a delivery to /api/webhooks/netlify really came from Netlify.
NETLIFY_WEBHOOK_SECRET=

# --- Model provider --------------------------------------------------------
# Passed to the agent container. The only credential it ever receives.
OPENROUTER_API_KEY=

# --- Sessions and sign-in --------------------------------------------------
# Signs magic-link tokens and session cookies. At least 32 characters.
SESSION_SECRET=
# Who may sign in. Comma separated, case insensitive. Deliberately NOT in the
# site's repository, so write access to the site cannot grant access to the
# editing interface (FR-003c1).
ALLOWED_EMAILS=jane@client.example,marketing@client.example

# --- Configuration credential ---------------------------------------------
# Stronger than the client credential, because it can change a live website.
# argon2id hash of the configuration password.
CONFIG_PASSWORD_HASH=
# Base32 shared secret for the time-based one-time code.
CONFIG_TOTP_SECRET=

# --- Notification ----------------------------------------------------------
# SMTP connection string, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
# Envelope sender for notification email.
SMTP_FROM=webagent@client.example

# --- This installation's own address --------------------------------------
# Used in magic links and as the Netlify webhook target.
PUBLIC_BASE_URL=http://localhost:3000
