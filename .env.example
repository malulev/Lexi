# Copy to .env.local and fill in. .env.local is gitignored and is deliberately
# unreadable by Claude Code sessions (see .claude/settings.json).
#
# Verify with `npm run check:env` — it reports which variables are missing or
# malformed, and never prints a value.

# --- Version control -------------------------------------------------------
# The GitHub App that may read and write contents and pull requests on the one
# repository this installation manages.
GITHUB_APP_ID=
# PEM private key. Newlines may be written literally as \n.
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
# owner/name of the single site repository (constitution VI).
GITHUB_REPO=

# --- Hosting ---------------------------------------------------------------
NETLIFY_TOKEN=
NETLIFY_SITE_ID=
# Shared with Netlify's outgoing webhook. Any random string when the webhook is
# not configured; the endpoint still refuses unsigned requests.
NETLIFY_WEBHOOK_SECRET=

# --- Model -----------------------------------------------------------------
OPENROUTER_API_KEY=

# --- Sessions and access ---------------------------------------------------
# At least 32 characters.
SESSION_SECRET=
# Comma-separated. The only addresses that may sign in; never read from the
# repository (FR-003c1).
ALLOWED_EMAILS=

# --- Developer configuration surface ---------------------------------------
CONFIG_PASSWORD_HASH=
CONFIG_TOTP_SECRET=

# --- Outgoing mail ---------------------------------------------------------
SMTP_URL=
SMTP_FROM=

# --- This deployment -------------------------------------------------------
# Absolute URL. Magic links are built from it, so it must be reachable by the
# client's browser.
PUBLIC_BASE_URL=http://localhost:3000

# --- Where this process keeps its scratch ------------------------------------
# The git mirror and the throwaway working trees. Defaults to /var/lib/webagent,
# which a development machine cannot write to — and the failure surfaces
# mid-request rather than at startup, so set it deliberately.
#
# Under docker-compose this must be the SAME absolute path on the host and in
# the container: the host's Docker daemon resolves the agent container's bind
# mounts, so a path that exists only inside this container cannot be mounted.
WEBAGENT_STATE_DIR=./.webagent-state

# --- Optional, read by docker-compose.yml ------------------------------------
# The port the application listens on.
PORT=3000
# The agent image built from agent/. Pinned here so a compose deployment and a
# local run agree on which one they mean.
AGENT_IMAGE=webagent/agent:latest

